# Database Connection
# By default, uses local SQLite for plug-and-play local execution:
DATABASE_URL=sqlite:///./fintech.db
# To connect to Supabase PostgreSQL in production:
# DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-SUPABASE-PROJECT-REF].supabase.co:5432/postgres

# JWT Authentication
SECRET_KEY=fintech_super_secret_jwt_key_technofora_2026_change_in_production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Google Gemini API for Financial Security Chatbot
# Leave empty to use built-in offline rule-based fraud analyzer, or supply your API key:
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# CORS Allowed Origins
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,*
